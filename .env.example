# Public site
# Local:
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Production (Netlify):
# SITE_URL=https://kikurae.com
# ALLOWED_ORIGINS=https://kikurae.com,https://www.kikurae.com

# Cloudflare Turnstile
# Dummy always-pass keys (dev only). A real secret rejects invalid tokens.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Age-gated destinations. Server-side only. Never prefix with NEXT_PUBLIC_.
EXCLUSIVE_DESTINATION_URL=
EXCLUSIVE_DESTINATION_URL_IG_ITSKIORAE=
EXCLUSIVE_DESTINATION_URL_IG_REALKIORAE=
EXCLUSIVE_DESTINATION_URL_X_KIKUMORII=
EXCLUSIVE_DESTINATION_URL_X_REALKIORAE=
EXCLUSIVE_DESTINATION_URL_REDDIT_KIKUMORI=

# Private stats dashboard at /stats
STATS_PASSWORD=

# Redirect token lifetime in seconds (clamped to 30–120)
REDIRECT_TOKEN_TTL_SECONDS=60

# memory is fine for a single Node process. Use Upstash on Netlify.
TOKEN_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

VERIFY_RATE_LIMIT=10
REDIRECT_RATE_LIMIT=30

# Optional analytics webhook. Payload never includes the destination URL.
ANALYTICS_WEBHOOK_URL=

# Public social links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/itskiorae/
NEXT_PUBLIC_X_URL=https://x.com/KikuMorii
